# ============================================
# GetFakeNow — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] will cause the app to crash in production if missing.
# Variables marked [OPTIONAL] have sensible defaults or enable optional features.

# ── Core ─────────────────────────────────────
NODE_ENV=development                          # "development" | "production"
PORT=3000                                     # [OPTIONAL] Server port (default: 3000)

# ── Security [REQUIRED in production] ────────
JWT_SECRET=your-secret-at-least-32-chars-long # [REQUIRED] Min 32 characters. Used for JWT signing + cookie encryption.
DATABASE_URL=mysql://user:pass@host:3306/db   # [REQUIRED] MySQL connection string. Min 10 characters.

# ── Site URL ─────────────────────────────────
VITE_SITE_URL=https://getfakenow.com          # [REQUIRED] Public URL of the site (used in emails, CORS, Stripe redirects)
SITE_URL=https://getfakenow.com               # Fallback if VITE_SITE_URL is not set

# ── Stripe [REQUIRED in production] ──────────
STRIPE_SECRET_KEY=sk_test_...                 # [REQUIRED] Stripe secret key. Min 10 characters.
STRIPE_WEBHOOK_SECRET=whsec_...               # [REQUIRED] Stripe webhook signing secret. Min 10 characters.
VITE_STRIPE_PUBLIC_KEY=pk_test_...            # [REQUIRED] Stripe publishable key (used in frontend)

# ── Google OAuth [OPTIONAL] ──────────────────
GOOGLE_CLIENT_ID=                             # Google OAuth 2.0 client ID
GOOGLE_CLIENT_SECRET=                         # Google OAuth 2.0 client secret

# ── Facebook OAuth [OPTIONAL] ────────────────
FACEBOOK_APP_ID=                              # Facebook App ID
FACEBOOK_APP_SECRET=                          # Facebook App Secret

# ── Manus/Forge OAuth [OPTIONAL] ─────────────
VITE_APP_ID=                                  # Manus App ID
OAUTH_SERVER_URL=                             # Manus OAuth server URL
OWNER_OPEN_ID=                                # Owner Open ID for Manus auth
BUILT_IN_FORGE_API_URL=                       # Forge API URL
BUILT_IN_FORGE_API_KEY=                       # Forge API Key

# ── S3/Object Storage [REQUIRED for image uploads] ──
AWS_ACCESS_KEY_ID=                            # S3-compatible access key
AWS_SECRET_ACCESS_KEY=                        # S3-compatible secret key
AWS_S3_BUCKET=                                # S3 bucket name
AWS_S3_REGION=                                # S3 region (e.g., ap-southeast-1)
AWS_S3_ENDPOINT=                              # [OPTIONAL] Custom S3 endpoint (for R2, MinIO, etc.)

# ── Email/SMTP [OPTIONAL — needed for transactional emails] ──
SMTP_HOST=                                    # SMTP server host
SMTP_PORT=587                                 # SMTP port
SMTP_USER=                                    # SMTP username
SMTP_PASS=                                    # SMTP password
SMTP_FROM=noreply@getfakenow.com              # From address for transactional emails
